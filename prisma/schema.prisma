// Study-Group — Prisma schema
// Postgres, normalized, with indexes on hot query paths.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- enums ----------

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum RSVPStatus {
  GOING
  MAYBE
  NOT_GOING
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ResourceType {
  PDF
  NOTE
  LINK
  VIDEO
  IMAGE
  DOCUMENT
}

enum EventKind {
  STUDY_SESSION
  ASSIGNMENT_DEADLINE
  EXAM
  PERSONAL_TASK
  GROUP_EVENT
}

enum SessionKind {
  GROUP
  EXAM_PREP
  PROBLEM_SOLVING
  REVISION
  DISCUSSION
  FOCUS
}

enum MessageKind {
  TEXT
  FILE
  SYSTEM
}

enum NoteKind {
  LECTURE
  EXAM
  CHEAT_SHEET
  PROBLEM_SOLUTION
  REVISION
}

enum NotificationKind {
  MESSAGE
  MENTION
  GROUP_INVITE
  JOIN_REQUEST
  SESSION_REMINDER
  TASK_DEADLINE
  RESOURCE_SHARED
  TASK_ASSIGNED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

enum ProfilePrivacy {
  PUBLIC
  GROUPS
  PRIVATE
}

enum StorageKind {
  LOCAL
  BLOB
}

// ---------- identity ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarUrl    String?
  university   String?
  course       String?
  semester     String?
  bio          String?
  subjects     String[] @default([])
  interests    String[] @default([])
  goals        String[] @default([])
  onboardedAt  DateTime?
  profilePrivacy ProfilePrivacy @default(PUBLIC)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedGroups      Group[]           @relation("GroupOwner")
  memberships      GroupMember[]
  messages         Message[]
  messageReactions MessageReaction[]
  tasksCreated     Task[]            @relation("TaskCreator")
  tasksAssigned    Task[]            @relation("TaskAssignee")
  sessionsCreated  StudySession[]    @relation("SessionCreator")
  rsvps            SessionRSVP[]
  eventsCreated    CalendarEvent[]
  resources        Resource[]
  bookmarks        ResourceBookmark[]
  notes            Note[]
  noteVersions     NoteVersion[]      @relation("NoteVersionEdits")
  focusLogs        StudySessionLog[]
  streak           StudyStreak?
  hostedFocusRooms FocusRoom[]        @relation("FocusRoomHost")
  focusRoomParticipations FocusRoomParticipant[]
  quizAttempts     QuizAttempt[]
  notifications    Notification[]
  aiConversations  AIConversation[]
  invitesSent      GroupInvite[]     @relation("InviteInviter")
  taskComments     TaskComment[]
  mentions         Mention[]

  @@index([university])
}

// ---------- groups ----------

model Group {
  id                 String   @id @default(cuid())
  name               String
  description        String   @default("")
  subject            String   @default("General")
  university         String?
  course             String?
  semester           String?
  difficulty         String?
  avatarUrl          String?
  isPublic           Boolean  @default(true)
  maxMembers         Int?
  tags               String[] @default([])
  pinnedAnnouncement String?
  ownerId            String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  owner     User               @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   GroupMember[]
  invites   GroupInvite[]
  messages  Message[]
  tasks     Task[]
  sessions  StudySession[]
  events    CalendarEvent[]
  resources Resource[]
  notes     Note[]
  focusRooms FocusRoom[]

  @@index([subject])
  @@index([university])
  @@index([isPublic, createdAt])
}

model GroupMember {
  id         String    @id @default(cuid())
  groupId    String
  userId     String
  role       Role      @default(MEMBER)
  joinedAt   DateTime  @default(now())
  lastSeenAt DateTime?
  lastReadMessageAt DateTime?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([lastSeenAt])
}

model GroupInvite {
  id        String       @id @default(cuid())
  groupId   String
  inviterId String
  code      String       @unique @default(cuid())
  status    InviteStatus @default(PENDING)
  expiresAt DateTime?
  createdAt DateTime     @default(now())

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviter User  @relation("InviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([groupId, status])
}

// ---------- chat ----------

model Message {
  id        String      @id @default(cuid())
  groupId   String
  userId    String
  kind      MessageKind @default(TEXT)
  content   String
  replyToId String?
  pinned    Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  group       Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyTo     Message?            @relation("MessageThread", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Message[]           @relation("MessageThread")
  reactions   MessageReaction[]
  attachments MessageAttachment[]
  mentions    Mention[]

  @@index([groupId, createdAt])
  @@index([userId])
}

// Structured mention rows — validated server-side at message creation.
model Mention {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  name      String
  url       String
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// ---------- tasks ----------

model Task {
  id             String     @id @default(cuid())
  title          String
  description    String?
  subject        String?
  groupId        String?
  creatorId      String
  assigneeId     String?
  dueDate        DateTime?
  priority       Priority   @default(MEDIUM)
  status         TaskStatus @default(TODO)
  progress       Int        @default(0)
  isRecurring    Boolean    @default(false)
  recurrenceRule String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  group    Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator  User   @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assignee User?  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments TaskComment[]

  @@index([assigneeId, status])
  @@index([groupId, status])
  @@index([dueDate])
}

// ---------- study sessions ----------

model StudySession {
  id              String      @id @default(cuid())
  groupId         String?
  title           String
  description     String?
  subject         String      @default("General")
  kind            SessionKind @default(GROUP)
  startsAt        DateTime
  endsAt          DateTime
  location        String?
  isOnline        Boolean     @default(false)
  maxParticipants Int?
  creatorId       String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  group   Group?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator User          @relation("SessionCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  rsvps   SessionRSVP[]

  @@index([startsAt])
  @@index([groupId, startsAt])
}

model SessionRSVP {
  id        String     @id @default(cuid())
  sessionId String
  userId    String
  status    RSVPStatus @default(GOING)
  attended  Boolean?
  createdAt DateTime   @default(now())

  session StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

// ---------- calendar ----------

model CalendarEvent {
  id         String    @id @default(cuid())
  groupId    String?
  creatorId  String
  title      String
  description String?
  kind       EventKind @default(STUDY_SESSION)
  startsAt   DateTime
  endsAt     DateTime
  location   String?
  reminderAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  group   Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([groupId, startsAt])
  @@index([creatorId, startsAt])
}

// ---------- resources ----------

model Resource {
  id          String       @id @default(cuid())
  groupId     String?
  uploaderId  String
  title       String
  description String?
  type        ResourceType @default(LINK)
  url         String
  mimeType    String?
  sizeBytes   Int?
  storageKind StorageKind?
  storageKey  String?
  isFile      Boolean  @default(false)
  tags        String[]     @default([])
  views       Int          @default(0)
  downloads   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  group     Group?             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  uploader  User               @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  bookmarks ResourceBookmark[]

  @@index([groupId, createdAt])
  @@index([type])
}

model ResourceBookmark {
  id         String   @id @default(cuid())
  resourceId String
  userId     String
  createdAt  DateTime @default(now())

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceId, userId])
}

// Task activity/comments — visible to the task's group or personal participants.
model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

// ---------- notes ----------

model Note {
  id        String   @id @default(cuid())
  groupId   String
  authorId  String
  title     String
  content   String   @default("")
  kind      NoteKind @default(LECTURE)
  tags      String[] @default([])
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group  Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  versions NoteVersion[]

  @@index([groupId, updatedAt])
}

// Immutable snapshot created on every note save — enables real version
// history and restore without pretending to be live co-editing.
model NoteVersion {
  id        String   @id @default(cuid())
  noteId    String
  version   Int
  title     String
  content   String
  kind      NoteKind
  tags      String[] @default([])
  editorId  String
  createdAt DateTime @default(now())

  note   Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  editor User @relation("NoteVersionEdits", fields: [editorId], references: [id], onDelete: Cascade)

  @@unique([noteId, version])
  @@index([noteId, version])
}

// ---------- focus & streaks ----------

model StudySessionLog {
  id             String      @id @default(cuid())
  userId         String
  groupId        String?
  kind           SessionKind @default(FOCUS)
  subject        String?
  startedAt      DateTime    @default(now())
  endedAt        DateTime?
  durationMinutes Int        @default(0)
  tasksCompleted Int         @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

model StudyStreak {
  id            String    @id @default(cuid())
  userId        String    @unique
  current       Int       @default(0)
  longest       Int       @default(0)
  lastStudyDate DateTime?
  weeklyGoalMin Int       @default(300)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- focus rooms (V5) ----------

// A shared focus session others can join. State lives server-side; the timer
// is derived from endsAt/pausedAtMs so every client computes the same time.
model FocusRoom {
  id           String   @id @default(cuid())
  hostId       String
  groupId      String?
  subject      String
  goal         String?
  durationMin  Int
  taskId       String?
  // WAITING | LIVE | PAUSED | COMPLETED | CANCELLED
  status       String   @default("LIVE")
  startedAt    DateTime @default(now())
  endsAt       DateTime
  // Epoch-ms pause bookkeeping. BigInt because epoch ms exceeds Int4 range —
  // a plain Int would throw "integer out of range" on the first pause.
  pausedAtMs   BigInt?
  pausedTotalMs BigInt  @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  host         User  @relation("FocusRoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  group        Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  participants FocusRoomParticipant[]

  @@index([status, endsAt])
  @@index([groupId, status])
}

model FocusRoomParticipant {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  // FOCUSING | PAUSED | COMPLETED
  presence  String   @default("FOCUSING")
  joinedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  room FocusRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId, lastSeenAt])
}

// ---------- quiz engine (V5) ----------

// One persisted quiz attempt with per-question answers for weak-topic analysis.
model QuizAttempt {
  id             String   @id @default(cuid())
  userId         String
  subject        String
  topic          String?
  difficulty     String   @default("MEDIUM")
  totalQuestions Int
  correctAnswers Int
  score          Int      // 0-100
  answersJson    String   // [{question, selectedAnswer, correctAnswer, isCorrect}]
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, subject])
}

// ---------- notifications ----------

model Notification {
  id        String           @id @default(cuid())
  userId    String
  kind      NotificationKind
  title     String
  body      String?
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

// ---------- AI assistant ----------

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  groupId   String?
  title     String   @default("New conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId, updatedAt])
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

# --- Database (required) ---
# Postgres connection string. On Vercel use Neon/Supabase/Vercel Postgres.
# Example: postgresql://user:password@host:5432/studygroup?schema=public&sslmode=require
DATABASE_URL=

# --- Auth (required) ---
# Secret used to sign session JWTs (32+ random bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- File uploads (optional; defaults to local-disk dev storage) ---
# STORAGE_PROVIDER: unset or "LOCAL" stores uploads on local disk under .uploads (development only).
# Set to "BLOB" on Vercel so uploads persist — requires the token below.
# STORAGE_PROVIDER=BLOB
# BLOB_READ_WRITE_TOKEN=

# --- AI assistant "StudyMate" (optional) ---
# When unset, the StudyMate panel shows a proper setup state instead of fake responses.
# Never expose these to the client — the server proxies all AI calls.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Redis (required only when running the optional realtime companion) ---
# Local development uses the Redis service in docker-compose.yml.
# Use rediss:// and private networking/authentication with a managed provider in production.
REDIS_URL=redis://localhost:6379
# Namespace shared by every realtime replica in one environment; use different values per environment.
REALTIME_REDIS_PREFIX=study-group:realtime:v1
# Only set true behind a trusted proxy that overwrites X-Forwarded-For.
REALTIME_TRUST_PROXY=false
# The integration suite writes only under a random test namespace. Set this explicitly to disposable Redis.
# REALTIME_TEST_REDIS_URL=redis://localhost:6379

# --- Optional group realtime companion service ---
# Run `npm run dev:realtime` locally and `npm run start:realtime` as a persistent Node service.
# The Next.js app and realtime service must share DATABASE_URL and the two independent secrets.
# Browser URL must be ws:// locally or wss:// in production, with the exact /ws path.
REALTIME_HOST=0.0.0.0
REALTIME_PORT=8787
REALTIME_PUBLIC_URL=ws://localhost:8787/ws
# Server-to-server URL; keep private/internal where possible.
REALTIME_PUBLISH_URL=http://127.0.0.1:8787/publish
# Comma-separated exact browser origins. Use only trusted app origins in production.
REALTIME_ALLOWED_ORIGINS=http://localhost:3000
# Generate both independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REALTIME_TICKET_SECRET=
REALTIME_PUBLISH_SECRET=

# Distributed realtime defaults: 300 upgrades/IP/min, 60 auth/IP/min,
# 6 typing frames per group/user/second, 6000 publishes/IP/min, 120 publishes/actor/min.
REALTIME_UPGRADE_LIMIT_PER_MINUTE=300
REALTIME_AUTH_LIMIT_PER_MINUTE=60
REALTIME_TYPING_LIMIT_PER_SECOND=6
REALTIME_PUBLISH_LIMIT_PER_MINUTE=6000
REALTIME_PUBLISH_ACTOR_LIMIT_PER_MINUTE=120
